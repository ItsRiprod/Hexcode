{
  "Armor": {
    "StatModifiers": {
      "Mana?": [
        {
          "Amount#": "round($Thorium.Mana * $Armor.Spread_Hands * $Armor.Mult_Mana)",
          "CalculationType": "Additive"
        }
      ],
      "Volatility?": [
        {
          "Amount#": "round($Thorium.Volatility * $Armor.Spread_Hands * $Armor.Mult_Volatility * 2) / 2",
          "CalculationType": "Additive"
        }
      ],
      "Affinity_Life": [
        {
          "Target": "Max",
          "CalculationType": "Additive",
          "Amount#": "round($Thorium.Affinity * $Armor.Spread_Hands * $Armor.Mult_Affinity)"
        }
      ]
    }
  }
}
