{
  "Armor": {
    "StatModifiers": {
      "Mana?": [
        {
          "Amount#": "round($Copper.Mana * $Armor.Spread_Hands * $Armor.Mult_Mana)",
          "CalculationType": "Additive"
        }
      ],
      "Volatility?": [
        {
          "Amount#": "round($Copper.Volatility * $Armor.Spread_Hands * $Armor.Mult_Volatility * 2) / 2",
          "CalculationType": "Additive"
        }
      ]
    }
  }
}
