$C = "../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 360);

    #Title {
      $C.@Title {
        @Text = "Name Hex";
      }
    }

    #Content {
      Padding: (Vertical: 16, Horizontal: 24);
      LayoutMode: Top;

      $C.@TextField #NameInput {
        @Anchor = (Height: 44);
        AutoFocus: true;
        PlaceholderText: "unnamed hex";
      }

      Group #ButtonRow {
        LayoutMode: Left;
        Anchor: (Top: 12, Height: 36);

        $C.@TextButton #ConfirmButton {
          Text: "Set Name";
          FlexWeight: 1;
        }
      }

      Label #StatusLabel {
        Style: (FontSize: 14, TextColor: #a0a0a0);
        Text: "";
        Anchor: (Top: 12, Height: 40);
      }
    }
  }
}

$C.@BackButton {}
