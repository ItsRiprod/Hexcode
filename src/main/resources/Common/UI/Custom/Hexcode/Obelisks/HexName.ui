$C = "../../Common.ui";
$O = "Obelisk.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 360);

    #Title {
      $C.@Title {
        @Text = %hexcode.obelisks.name.title;
      }
    }

    #Content {
      Padding: (Vertical: 16, Horizontal: 24);
      LayoutMode: Top;

      $C.@TextField #NameInput {
        Anchor: (Height: 44);
        AutoFocus: true;
        AutoSelectAll: true;
        PlaceholderText: %hexcode.obelisks.name.placeholder;
      }

      Group #ButtonRow {
        LayoutMode: Left;
        Anchor: (Top: 12, Height: 36);

        $C.@TextButton #ConfirmButton {
          Text: %hexcode.obelisks.name.confirm;
          FlexWeight: 1;
        }
      }

      Label #StatusLabel {
        Style: $O.@StatusStyle;
        Anchor: (Top: 12);
      }
    }
  }
}

$C.@BackButton {}
