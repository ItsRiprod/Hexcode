$C = "../../Common.ui";
$O = "Obelisk.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 420);

    #Title {
      $C.@Title {
        @Text = %hexcode.obelisks.transfer.title;
      }
    }

    #Content {
      Padding: (Vertical: 16, Horizontal: 24);
      LayoutMode: Top;

      $C.@MultilineTextField #DataField {
        @Anchor = (Height: 120);
        Style: InputFieldStyle(FontSize: 10, TextColor: #e0e0e0);
        AutoFocus: true;
        AutoSelectAll: true;
        PlaceholderText: %hexcode.obelisks.transfer.placeholder;
      }

      Group #ButtonRow {
        LayoutMode: Left;
        Anchor: (Top: 12, Height: 36);

        $C.@TextButton #ExportButton {
          @Anchor = (Right: 8);
          Text: %hexcode.obelisks.transfer.export;
          FlexWeight: 1;
        }

        $C.@TextButton #ImportButton {
          Text: %hexcode.obelisks.transfer.import;
          FlexWeight: 1;
        }
      }

      Label #StatusLabel {
        Style: $O.@StatusStyle;
        Anchor: (Top: 12);
      }
    }
  }
}

$C.@BackButton {}
