Group #HexcodeHud {
  LayoutMode: Bottom;

  Group #HexcodeInfo {
    LayoutMode: Left;
    Anchor: (Bottom: 80, Left: 20, Width: 380);
    Visible: false;

    Group #HexcodeInfoAccent {
      Background: #7b5cff;
      Anchor: (Width: 3);
    }

    Group #HexcodeInfoContent {
      Background: #0a0a14(0.85);
      Anchor: (Left: 3);
      FlexWeight: 1;
      Padding: (Left: 12, Right: 16, Vertical: 6);
      LayoutMode: Top;

      Label #HexcodeInfoTitle {
        Style: (FontSize: 18, TextColor: #c4b5ff, Wrap: true);
      }

      Label #HexcodeInfoDescription {
        Style: (FontSize: 14, TextColor: #a0a0a0, Wrap: true);
        Visible: false;
      }
    }
  }
}
